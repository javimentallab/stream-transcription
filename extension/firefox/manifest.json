{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "short_name": "Stream Transcription",
  "description": "__MSG_extDescription__",
  "version": "2.0.0",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "stream-transcription@javimentallab",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["websiteContent"] }
    }
  },
  "permissions": ["storage", "<all_urls>"],
  "background": {
    "scripts": ["common.js", "i18n.js", "engine-common.js", "background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["common.js", "engine-common.js", "overlay.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": ["audiopreprocessor.js"],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_ui": { "page": "settings.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png" }
}
